# Treat these as binary — Git should never try to convert line endings
# or run text-diffs on them (prevents corruption on Windows).
*.pkl binary
*.csv binary
*.png binary
*.jpg binary
*.jpeg binary

# Keep line endings consistent for text/code files across Windows/Mac/Linux
*.py text eol=lf
*.md text eol=lf
*.html text eol=lf
*.ipynb text eol=lf
*.txt text eol=lf

# Don't let GitHub's language-detection count the notebook's embedded
# outputs/JSON noise as the repo's "main language"
*.ipynb linguist-generated=false
